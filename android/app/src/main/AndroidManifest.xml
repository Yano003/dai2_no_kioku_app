<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 音声で予定を登録するために使用する。（要件定義書 4.2） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- 端末標準の音声認識はネットワーク経由で処理される場合があるため必要。
         アプリ自身がサーバーへデータを送ることはない。（要件定義書 7.1） -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13 (API 33) 以降は通知の表示にも実行時の許可が必要。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 前日夜・当日朝の通知を設定時刻どおりに届けるために使用する。
         USE_EXACT_ALARM は Android 13 以降で自動的に許可されるが、
         Google Play では「アラーム・カレンダー等が主機能のアプリ」に
         用途が限定されており、ストア申請時に用途の申告が必要。
         本アプリは予定の通知が主機能のため対象に該当する。（要件定義書 6.1） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- 端末を再起動すると予約済みの通知はすべて消えるため、
         起動完了を受け取って通知を登録し直す。（要件定義書 6.3） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- 予定データは「端末内にのみ保存」がプライバシーポリシー上の前提。
             allowBackup を無効化しないと、Android の自動バックアップ経由で
             予定データが利用者の Google アカウントへコピーされ得るため、
             この前提が崩れる。（弁護士レビュー 2026/08/26 対応） -->
        <!-- launchMode は Flutter の既定（singleTop）から singleTask へ変更している。
             通知をタップしたときに、その通知が指す日のカードを開くために必要。

             flutter_local_notifications がタップ用に組み立てる Intent は
             PackageManager#getLaunchIntentForPackage をもとにしており、
             CATEGORY_LAUNCHER と FLAG_ACTIVITY_NEW_TASK を保持したままになる。
             singleTop の場合、アプリのタスクが履歴（最近使ったアプリ）に残った
             ままプロセスだけが終了している状態でタップすると、Android は新しい
             Intent を渡さずに履歴からタスクを復元する。すると
               ・onNewIntent が呼ばれない
               ・getIntent() が起動時の Intent（SELECT_NOTIFICATION ではない）になる
               ・FLAG_ACTIVITY_LAUNCHED_FROM_HISTORY が立つ
             の3つが重なり、プラグインは「通知から起動された」と判定できず、
             payload（開くカードの日付）が捨てられる。結果、通常の起動と同じ
             扱いになり、明日のカードではなく今日のカードから始まってしまう。
             （お客様ご指摘 2026/08/17）

             singleTask にすると、既に存在するタスクへ Intent が届けられ、
             onNewIntent が確実に呼ばれる。

             本アプリの画面はすべて Flutter 側の Navigator で切り替えており、
             Android の Activity は MainActivity だけである。端末の設定画面
             （app_settings）は別アプリのタスクとして開くため影響しない。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 予約済み通知の発火を受け取る。 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>

        <!-- 端末の再起動後に、予約済みの通知を復元する。 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11 (API 30) 以降、音声認識サービスを利用するには
             パッケージの可視性の宣言が必要。これが無いと端末に音声認識が
             あっても「利用できない」と判定される。 -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
